BACKEND_BASE_URL=http://localhost:5000

# ── LLM provider ──────────────────────────────────────────────────────────
# Primary provider: "groq" (fast, default) or "nvidia". The other one is
# used automatically as a fallback when the primary fails.
LLM_PROVIDER=groq

# Groq (primary) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# NVIDIA (fallback) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
